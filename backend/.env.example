# MAPO | Backend NestJS | Configuracion privada local
# Archivo ignorado por Git. Conserva los valores dentro de este archivo.
# En Vercel las variables se agregan en Settings > Environment Variables.
# Cambiar este archivo NO actualiza automaticamente el despliegue.

# ------------------------------------------------------------------
# 1. SERVIDOR LOCAL - listo
# PORT se usa en desarrollo. Vercel asigna el puerto automaticamente.
# ------------------------------------------------------------------
PORT=3000
APP_URL=https://mapo-experiencias-api.vercel.app

# ------------------------------------------------------------------
# 2. SUPABASE MAPO - listo
# Proyecto MAPO: affhiuzxhejwolcoivnf.
# No necesitas DATABASE_URL, service_role ni clave secreta para este backend.
# ------------------------------------------------------------------
SUPABASE_URL=https://affhiuzxhejwolcoivnf.supabase.co
SUPABASE_PUBLISHABLE_KEY=""

# ------------------------------------------------------------------
# 3. CORREO DE MAPO - completar solo SMTP_PASSWORD
# Usar la cuenta somosmapoapp@gmail.com.
# 1) Activar verificacion en dos pasos.
# 2) Crear una contrasena de aplicacion llamada MAPO:
#    https://myaccount.google.com/apppasswords
# 3) Pegar los 16 caracteres en SMTP_PASSWORD, entre comillas y sin espacios.
# No usar la contrasena normal de Gmail.
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=somosmapoapp@gmail.com
SMTP_FROM=somosmapoapp@gmail.com
SMTP_SENDER_NAME=MAPO
SMTP_PASSWORD=""

# ------------------------------------------------------------------
# 4. CONFIGURACION INICIAL DE AUTH - completar una vez
# Crear token con la cuenta Supabase MAPO:
# https://supabase.com/dashboard/account/tokens
# Limitarlo al proyecto MAPO, con vencimiento corto.
# Permisos: Auth Config y Project Settings, ambos Read-write.
# Uso: desde backend, ejecutar npm run configure:auth.
# Activa SMTP, las plantillas de correo y los enlaces de regreso a la app.
# No poner este token en Vercel ni Flutter.
# Tras configurar, quitar el token del archivo y revocarlo en Supabase.
# ------------------------------------------------------------------
SUPABASE_MANAGEMENT_TOKEN=""

SUPABASE_PRIVATE_MEDIA=true
