{
  "compilerOptions": {
    "module": "Node16", "target": "ES2022", "outDir": "dist", "rootDir": "src",
    "moduleResolution": "Node16", "esModuleInterop": true, "experimentalDecorators": true,
    "emitDecoratorMetadata": true, "strict": true, "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
